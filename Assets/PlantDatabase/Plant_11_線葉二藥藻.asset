  m_Name: "Plant_11_\u7DDA\u8449\u4E8C\u85E5\u85FB"
  m_EditorClassIdentifier: 
  plantName: "\u7DDA\u8449\u4E8C\u85E5\u85FB"
  scientificName: Halodule pinifolia
  description: "\u9E7D\u6C34\u6C88\u6C34\u690D\u7269\uFF0C\u5C6C\u65BC\u7DAD\u7BA1\u675F\u690D\u7269\u3002\u8449\u6241\u7D30\uFF0C\u5176\u751F\u80B2\u5730\u8207\u5375\u8449\u9E7D\u85FB\u76F8\u540C\u3002\u5169\u8005\u5408\u7A31\u70BA\u300C\u8766\u8349\u300D\uFF0C\u69CD\u8766\u65CF\u7FA4\u5728\u6B64\u71DF\u751F\uFF0C\u69CD\u8766\u8207\u9C15\u864E\u7684\u5171\u751F\u6232\u78BC\u4E5F\u5728\u6B64\u4E0A\u6F14\u3002\u7531\u65BC\u68F2\u5730\u72F9\u9698\uFF0C\u53C8\u906D\u53D7\u4EBA\u70BA\u7834\u58DE\uFF0C\u76EE\u524D\u65CF\u7FA4\u6578\u91CF\u6B63\u92B3\u6E1B\u4E2D\uFF0C\u6025\u9700\u5217\u5165\u4FDD\u8B77\u76E3\u7BA1\u3002\u53EF\u5728\u8B1B\u7F8E\u3001\u93AE\u6D77\u9593\u7684\u6F6E\u9593\u5E36\u767C\u73FE\u5176\u7E31\u8DE1\uFF0C\u662F\u6F8E\u6E56\u73FE\u5B58\u65CF\u7FA4\u6578\u91CF\u6700\u5927\u7684\u6D77\u8349\u5340\uFF0C\u5C90\u982D\u7063\u53CA\u897F\u5DBC\u6A6B\u7901\u4EA6\u6709\u5176\u65CF\u7FA4\u3002\r\n\u6F8E\u6E56\u76F8\u95DC\u6545\u4E8B\uFF1A\u7DDA\u8449\u4E8C\u85E5\u85FB\u591A\u5206\u5E03\u65BC\u6F8E\u6E56\u6F6E\u4E0B\u5E36\u81F3\u6DFA\u6D77\u5CA9\u7901\u5340\uFF0C\u5C6C\u9644\u8457\u6027\u7D05\u85FB\uFF0C\u504F\u597D\u6E05\u6F88\u3001\u9AD8\u9E7D\u5EA6\u4E14\u6C34\u6D41\u7A69\u5B9A\u7684\u6D77\u57DF\u3002\u6F8E\u6E56\u5468\u570D\u6D77\u6C34\u900F\u660E\u5EA6\u9AD8\u3001\u5CA9\u7901\u5730\u5F62\u767C\u9054\uFF0C\u63D0\u4F9B\u826F\u597D\u9644\u8457\u74B0\u5883\uFF0C\u4F7F\u7DDA\u8449\u4E8C\u85E5\u85FB\u80FD\u7A69\u5B9A\u751F\u9577\uFF0C\u6210\u70BA\u6F8E\u6E56\u6D77\u85FB\u751F\u614B\u7684\u91CD\u8981\u6210\u54E1\u4E4B\u4E00\u3002\r\n"
