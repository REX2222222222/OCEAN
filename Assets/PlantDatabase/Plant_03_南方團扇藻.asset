  plantName: "\u5357\u65B9\u5718\u6247\u85FB"
  scientificName: Padina australis
  description: "\u4EBA\u9593\u56DB\u6708\u5929\uFF0C\u6C99\u6E2F\u6F6E\u6C60\u4E2D\u7684\u5718\u6247\u85FB\u6F2B\u751F\uFF0C\u9EC3\u8910\u8272\u76F4\u7ACB\u5713\u6247\u72C0\u7684\u85FB\u9AD4\u76F8\u4E92\u5C64\u758A\uFF0C\u85FB\u9AD4\u6247\u90E8\u5177\u540C\u5FC3\u7D0B\uFF0C\u8179\u9762\u5247\u56E0\u5177\u8584\u5C64\u77F3\u7070\u8CEA\uFF0C\u800C\u5448\u7070\u767D\u8272\uFF0C\u9AD4\u9AD8\u53EF\u905410-15\u516C\u5206\u3002\u5357\u65B9\u5718\u6247\u85FB\u751F\u9577\u65BC\u6D77\u6D6A\u885D\u64CA\u7684\u6F6E\u9593\u5E36\u4E2D\u3001\u4E0B\u90E8\u77F3\u6CBC\u4E2D\uFF0C12\u6708\u81F3\u6B21\u5E746\u6708\u5747\u53EF\u898B\u3002\r\n\u6F8E\u6E56\u76F8\u95DC\u6545\u4E8B\uFF1A\u5357\u65B9\u5718\u6247\u85FB\u5E38\u898B\u65BC\u6F8E\u6E56\u6DFA\u6D77\u7901\u5340\u8207\u6F6E\u4E0B\u5E36\uFF0C\u504F\u597D\u6E05\u6F88\u3001\u9AD8\u9E7D\u5EA6\u4E14\u5149\u7167\u5145\u8DB3\u7684\u6D77\u57DF\u3002\u6F8E\u6E56\u5468\u570D\u6D77\u6C34\u900F\u660E\u5EA6\u9AD8\u3001\u6D77\u6D41\u7A69\u5B9A\uFF0C\u52A0\u4E0A\u73CA\u745A\u7901\u8207\u5CA9\u7901\u5730\u5F62\u767C\u9054\uFF0C\u63D0\u4F9B\u826F\u597D\u9644\u8457\u57FA\u8CEA\uFF0C\u4F7F\u5357\u65B9\u5718\u6247\u85FB\u80FD\u9806\u5229\u751F\u9577\uFF0C\u6210\u70BA\u7576\u5730\u71B1\u5E36\u8207\u4E9E\u71B1\u5E36\u6D77\u85FB\u7684\u91CD\u8981\u6210\u54E1\u4E4B\u4E00\u3002\r\n\n"
